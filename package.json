{
  "name": "tunefree-desktop",
  "version": "1.1.42",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3101 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1 --port 3101 --strictPort",
    "lint": "oxlint --config .oxlintrc.json src app scripts bump-version.js --deny-warnings",
    "typecheck": "tsc --noEmit",
    "architecture:check": "node scripts/check-architecture.mjs && node scripts/check-ipc-contract.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "api:verify:gd": "node scripts/verify-gd-studio-api.mjs",
    "audit": "npm audit --audit-level=high",
    "test": "vitest",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "version:check": "node bump-version.js --dry-run",
    "version:bump": "node bump-version.js",
    "version:bump:minor": "node bump-version.js --minor",
    "version:bump:major": "node bump-version.js --major"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "framer-motion": "^14.10.0",
    "lucide-react": "^1.70.0",
    "pako": "^3.0.3",
    "qrc-decoder": "^1.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.91.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "overrides": {
    "postcss": "^8.5.32"
  }
}
