{
  "name": "tunefree-desktop",
  "version": "1.1.29",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3101 --strictPort",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1 --port 3101 --strictPort",
    "lint": "oxlint --config .oxlintrc.json src app scripts bump-version.js --deny-warnings",
    "typecheck": "tsc --noEmit",
    "architecture:check": "node scripts/check-architecture.mjs && node scripts/check-ipc-contract.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "api:verify:gd": "node scripts/verify-gd-studio-api.mjs",
    "audit": "npm audit --audit-level=high",
    "test": "vitest",
    "test:coverage": "vitest --run --coverage",
    "tauri": "tauri",
    "version:check": "node bump-version.js --dry-run",
    "version:bump": "node bump-version.js",
    "version:bump:minor": "node bump-version.js --minor",
    "version:bump:major": "node bump-version.js --major"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "pako": "^3.0.1",
    "qrc-decoder": "^1.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.73.0",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.16"
  }
}
